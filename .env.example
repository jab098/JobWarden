NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only local product mode. Honoured only by NODE_ENV=development.
JOBWARDEN_DEV_ACCESS_BYPASS=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only bootstrap credential. Never copy this into apps/web/.env.local.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
INGESTION_CRON_SECRET=
# Server-only Reed Jobseeker API credential. Leave empty until the source is reviewed and enabled.
REED_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
ADMIN_BOOTSTRAP_USER_ID=
